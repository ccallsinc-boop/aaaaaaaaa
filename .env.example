# Preset de build. O netlify.toml já define isso no Netlify.
# NITRO_PRESET=netlify

# Domínio público do site. Entra em canonical, hreflang, og:image, schema,
# sitemap e robots.txt. Precisa estar presente NO BUILD, porque o Vite embute
# o valor no bundle. Sem ele, o site cai no fallback durcle.netlify.app.
VITE_SITE_URL=https://seu-dominio.com

# Supabase, usado pela área de membros em /biblioteca e /auth.
# As VITE_ são lidas no cliente e precisam existir no build.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# As mesmas credenciais para o lado servidor (SSR e middleware de auth).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Opcional: host e porta do servidor de desenvolvimento.
# VITE_DEV_HOST=127.0.0.1
# VITE_DEV_PORT=8080
